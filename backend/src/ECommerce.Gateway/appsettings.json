{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft": "Warning" }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "ecommerce-api": {
        "ClusterId": "ecommerce-api",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "ecommerce-api": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5062/" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
